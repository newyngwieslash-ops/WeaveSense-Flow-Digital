# PRD §14 deployment profiles. core is the base stack; add e.g. core,telegram,extract,research.
COMPOSE_PROFILES=core
# WeaveSense-Flow environment template. Copy to .env.flow; never commit real secrets.
FLOW_HTTP_PORT=8088
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
PLATFORM_DB_NAME=flow_platform
PLATFORM_DB_USER=flow_platform
PLATFORM_DB_PASSWORD=change-me
INTEL_DB_NAME=flow_intel
INTEL_DB_USER=flow_intel
INTEL_DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
MINIO_ROOT_USER=flowadmin
MINIO_ROOT_PASSWORD=change-me-min-8-chars
PLATFORM_BUCKET=flow-platform
INTEL_BUCKET=flow-intel
# Internal execution-context signing (platform -> Loom Engine), see docs/flow/service-contracts.md
FLOW_INTERNAL_JWT_ISSUER=flow-platform
FLOW_INTERNAL_JWT_AUDIENCE=loom-engine
FLOW_INTERNAL_JWT_SIGNING_KEY=change-me-32-bytes-min
FLOW_INTERNAL_TOKEN_TTL_SECONDS=300
# Platform Model Gateway: an OpenAI-compatible /chat/completions base URL used by
# research/brief synthesis. Leave empty to disable LLM synthesis (evidence-only reports).
# Optional status endpoint for reconciling lost responses: GET <url>?idempotency_key=K
# -> {"status":"succeeded|not_found|pending","total_tokens":N}. Requests carry Idempotency-Key.
FLOW_MODEL_GATEWAY_URL=
FLOW_MODEL_GATEWAY_KEY=
FLOW_MODEL_GATEWAY_MODEL=
FLOW_MODEL_GATEWAY_STATUS_URL=
# MCP OAuth (client credentials): connection credentialRef "oauth:FLOW_MCP_OAUTH_<NAME>" reads
# FLOW_MCP_OAUTH_<NAME>_TOKEN_URL / _CLIENT_ID / _CLIENT_SECRET / optional _SCOPE / _AUDIENCE.
# Telegram media (Telethon worker): max bytes per item and download timeout.
TELEGRAM_MEDIA_MAX_BYTES=20971520
TELEGRAM_MEDIA_TIMEOUT_SECONDS=15
# Object storage images (upstream minio/minio + minio/mc are no longer pullable).
FLOW_MINIO_IMAGE=cgr.dev/chainguard/minio:latest
FLOW_MC_IMAGE=bitnamilegacy/minio-client:2025.7.21
LOOM_DIRECT_PROVIDER_KEYS=disabled
TZ=UTC
# Loom Engine (services/loom-engine/flow/main.ts)
LOOM_SCHEDULER_TICK_MS=15000
LOOM_AUTO_MIGRATE=true
# Live connectors (A19). Leave empty until you do local acceptance; see docs/flow/local-acceptance.md.
TELEGRAM_WORKER_URL=
# Bearer for the Telethon worker /v1/media (attachments are stored after history); random, 24+ chars.
TELEGRAM_MEDIA_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
WECHAT_GATEWAY_URL=
WECHAT_GATEWAY_TOKEN=
# Interactive MCP OAuth (authorization code + PKCE): credentialRef "oauthcode:FLOW_MCP_OAUTHCODE_<NAME>" reads
# FLOW_MCP_OAUTHCODE_<NAME>_AUTH_URL/_TOKEN_URL/_CLIENT_ID/_CLIENT_SECRET/_SCOPE/_REVOKE_URL/_REDIRECT_URL
# (redirect: https://<host>/api/intelligence/mcp/oauth/callback). Token encryption key (>= 32 chars):
FLOW_OAUTH_ENC_KEY=

# --- Optional enrichment (loom-upstream collection capability) ---
# Article reader for POST /v1/documents/extract {"via":"reader"}: hosted reader,
# only for the comma-separated hostnames below (exact names, no wildcards).
ARTICLE_READER_ENABLED=false
ARTICLE_READER_ALLOWED_HOSTS=
# YouTube subtitles for POST /v1/documents/transcript (requires `--profile subtitles`).
# Two DIFFERENT random tokens, 24-128 chars of [A-Za-z0-9_-].
SUBTITLE_ENABLED=false
SUBTITLE_URL=http://subtitle-egress:8794
SUBTITLE_SERVICE_TOKEN=
SUBTITLE_PROXY_TOKEN=
# WeChat gateway (`--profile wechat`): WECHAT_GATEWAY_URL=http://wechat-gateway:8790 above, plus
WECHAT_PRIMARY_ALLOWED_HOSTS=
# OCR + attachment retry (`--profile extract`). Random token, shared by engine and ocr-worker.
OCR_ENABLED=false
OCR_SERVICE_TOKEN=
# With --profile extract and/or research: hand OCR/attachment-retry and brief loops to loom-enrich / loom-research.
LOOM_SPLIT_ROLES=false

# --- Notifications (email / webhook) ---
FLOW_PUBLIC_BASE_URL=
FLOW_NOTIFY_SMTP_HOST=
FLOW_NOTIFY_SMTP_PORT=587
FLOW_NOTIFY_SMTP_USERNAME=
FLOW_NOTIFY_SMTP_PASSWORD=
FLOW_NOTIFY_SMTP_FROM=
FLOW_NOTIFY_SMTP_ENCRYPTION=starttls
# --- Pricing / monitoring ---
# FLOW_PRICE_BOOK: JSON {"version":"price_v2","unit_micro":{"ocr_pages":2000,...}}; unset = built-in price_v1.
FLOW_PRICE_BOOK=
# Enables platform GET /metrics/flow (Bearer token); also put it in deploy/flow/monitoring/platform.token.
FLOW_METRICS_TOKEN=
