{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.weavesense.invalid/agriculture/v1/delegation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issuer",
    "audience",
    "subject",
    "actor",
    "tenant_id",
    "workspace_id",
    "resource_scope",
    "scopes",
    "authorization_version",
    "issued_at",
    "expires_at",
    "jti",
    "trace_id",
    "request_id",
    "request"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "issuer": {
      "const": "flow-platform"
    },
    "audience": {
      "const": "agri-gis"
    },
    "subject": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user",
            "service"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
        }
      }
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "resource_scope": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.weavesense.invalid/agriculture/v1/common.schema.json#/$defs/resource"
      },
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^agri\\.[a-z_]+\\.(read|create|update|delete|submit|cancel|publish|review|claim)$"
      },
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true
    },
    "authorization_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "jti": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/internal/agri/v1/[A-Za-z0-9_/-]+$"
        },
        "canonicalization_version": {
          "const": "sorted-json-v1"
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "request": {
            "properties": {
              "method": {
                "enum": [
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE"
                ]
              }
            },
            "required": [
              "method"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "required": [
              "canonicalization_version",
              "payload_hash",
              "operation_id"
            ]
          }
        }
      }
    }
  ]
}
