# Runtime-only configuration, copied to private .env.flow.runtime (0600).
# NEVER copy the entire .env.flow: it contains database bootstrap/owner secrets.
# Do not include POSTGRES_*PASSWORD, *_MIGRATION_PASSWORD,
# LOOM_MIGRATION_DATABASE_URL, or a migration/admin DATABASE_URL here.
# Compose supplies app/dispatcher DSNs separately to only their owning service.
# Add only optional runtime settings you use, from .env.flow.example; leave
# production credentials empty until separately provisioned by the operator.
FLOW_INTERNAL_JWT_ISSUER=flow-platform
FLOW_INTERNAL_JWT_AUDIENCE=loom-engine
FLOW_INTERNAL_JWT_SIGNING_KEY=
FLOW_INTERNAL_TOKEN_TTL_SECONDS=300
LOOM_SPLIT_ROLES=false
FLOW_METRICS_TOKEN=
METRICS_TOKEN=
