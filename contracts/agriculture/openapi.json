        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized projection; private cache only",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "./job.schema.json"
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "request_id",
                        "schema_version"
                      ],
                      "properties": {
                        "request_id": {
                          "type": "string"
                        },
                        "schema_version": {
                          "const": "1.0"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Missing or outside authorization scope"
          }
        },
        "x-implementation-status": "contract_only"
      }
    },
