{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.weavesense.invalid/agriculture/v1/job.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "operation_id",
    "tenant_id",
    "workspace_id",
    "status",
    "state_revision",
    "outcome",
    "cancel_requested",
    "retry_of_job_id",
    "attempt",
    "result_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "retry_wait",
        "cancelling",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "state_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "outcome": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "valid_result",
            "insufficient_data",
            "not_applicable",
            "execution_failed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "cancel_requested": {
      "type": "boolean"
    },
    "retry_of_job_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempt_no",
            "worker_id",
            "fencing_token",
            "lease_until"
          ],
          "properties": {
            "attempt_no": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "worker_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
            },
            "fencing_token": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "lease_until": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "result_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "queued",
              "running",
              "retry_wait",
              "cancelling",
              "cancelled"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "type": "null"
          },
          "result_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "valid_result",
              "insufficient_data",
              "not_applicable"
            ]
          },
          "result_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "const": "execution_failed"
          },
          "result_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "running"
          }
        }
      },
      "then": {
        "properties": {
          "attempt": {
            "type": "object"
          }
        }
      }
    }
  ]
}
