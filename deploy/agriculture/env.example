# Copy to a private local env file; never overwrite an existing configuration.
# These empty placeholders are NOT usable credentials. Compose refuses startup
# until each required value is supplied. Never commit/log the filled file.
# Generate independent >=32-character URL-safe random secrets using your local
# approved password manager. File permissions 0600; no URL punctuation in DB passwords.
POSTGRES_PASSWORD=
PLATFORM_MIGRATION_PASSWORD=
PLATFORM_RUNTIME_PASSWORD=
INTEL_MIGRATION_PASSWORD=
INTEL_RUNTIME_PASSWORD=
GEO_MIGRATION_PASSWORD=
GEO_RUNTIME_PASSWORD=
# Reserved restricted background identity: no default table access, no production
# job runner enabled. Never reuse the migration/runtime password or give to Web.
GEO_WORKER_PASSWORD=
REDIS_PASSWORD=
# Existing Flow/Loom HS256 secret, not a DT012 Ed25519 private key or browser value.
FLOW_INTERNAL_JWT_SIGNING_KEY=
# Bounded readiness probe only (not GIS business); loopback binding.
AGRI_HTTP_PORT=8090
# Same-origin React/Vue/platform gateway; loopback binding.
AGRI_WEB_PORT=8091
# Exact external HTTPS origin, with no trailing slash/path/query. No Host or
# forwarded header can supply this authority. Leave blank until configured.
FLOW_AGRICULTURE_EXTERNAL_ORIGIN=
# Explicit isolated local HTTP only: literal 127.0.0.1 or [::1], never localhost.
FLOW_AGRICULTURE_ALLOW_HTTP_LOOPBACK_DEV=false
# Absolute path to an existing regular 0600 file containing exactly 32 random
# raw bytes, mounted read-only. Share the same file across platform replicas.
# Independent of Flow/Loom JWT and DT012 Ed25519 keys; never commit this file.
FLOW_AGRICULTURE_CSRF_KEY_FILE=
