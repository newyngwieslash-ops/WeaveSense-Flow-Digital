{
  "openapi": "3.1.0",
  "info": {
    "title": "WeaveSense Agriculture versioned contract subsets",
    "version": "1.0.0",
    "description": "Existing analysis/job subset remains contract-only. Farm routes are DT025 implementation in progress; this document does not certify runtime or live acceptance."
  },
  "servers": [
    {
      "url": "/api/agri/v1"
    }
  ],
  "x-implementation-status": "partial_implementation_in_progress",
  "paths": {
    "/analyses": {
      "post": {
        "operationId": "submitAgriAnalysis",
        "security": [
          {
            "platformSession": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./analysis-submit.schema.json"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Durably accepted operation, not completed execution or settled charge",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "operation_id",
                        "job_id",
                        "status_url",
                        "events_url"
                      ],
                      "properties": {
                        "operation_id": {
                          "type": "string"
                        },
                        "job_id": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "status_url": {
                          "type": "string",
                          "pattern": "^/api/agri/v1/operations/[A-Za-z0-9_-]+$"
                        },
                        "events_url": {
                          "type": "string",
                          "pattern": "^/api/agri/v1/operations/[A-Za-z0-9_-]+/events$"
                        }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "request_id",
                        "schema_version"
                      ],
                      "properties": {
                        "request_id": {
                          "type": "string"
                        },
                        "schema_version": {
                          "const": "1.0"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Untrusted or expired session"
          },
          "402": {
            "description": "Budget insufficient"
          },
          "403": {
            "description": "Capability/CSRF denied"
          },
          "409": {
            "description": "Idempotency conflict or stale approval"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        },
        "x-implementation-status": "contract_only"
      }
    },
    "/jobs/{id}": {
