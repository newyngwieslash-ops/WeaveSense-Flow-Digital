{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.weavesense.invalid/agriculture/v1/service-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issuer", "subject", "audience", "capability", "tenant_id", "workspace_id", "issued_at", "expires_at", "jti", "trace_id", "request_id", "request"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "issuer": {"enum": ["flow-platform", "agri-gis"]},
    "subject": {"enum": ["flow-platform", "agri-gis"]},
    "audience": {"enum": ["flow-platform", "agri-gis"]},
    "capability": {"enum": ["ownership.resolve", "authority.check"]},
    "tenant_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"},
    "workspace_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"},
    "issued_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "expires_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "jti": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"},
    "trace_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "canonicalization_version", "payload_hash"],
      "properties": {
        "method": {"const": "POST"},
        "path": {"enum": ["/internal/agri/v1/ownership/resolve", "/internal/agri/v1/authority/check"]},
        "canonicalization_version": {"const": "rfc8785-safe-v1"},
        "payload_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"capability": {"const": "ownership.resolve"}}},
      "then": {"properties": {"issuer": {"const": "flow-platform"}, "subject": {"const": "flow-platform"}, "audience": {"const": "agri-gis"}, "request": {"properties": {"path": {"const": "/internal/agri/v1/ownership/resolve"}}}}},
      "else": {"properties": {"issuer": {"const": "agri-gis"}, "subject": {"const": "agri-gis"}, "audience": {"const": "flow-platform"}, "request": {"properties": {"path": {"const": "/internal/agri/v1/authority/check"}}}}}
    }
  ]
}
